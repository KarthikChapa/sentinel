      "service": "ci-bot"
    },
    "fixtures": {
      "cloudtrail": [
        {
          "action": "s3:GetObject",
          "count": 50,
          "last_used": "2026-08-28"
        },
        {
          "action": "ecr:GetAuthorizationToken",
          "count": 60,
          "last_used": "2026-08-27"
        }
      ],
      "last_accessed": [
        {
          "service": "s3",
          "last_accessed": "2026-08-28"
        },
        {
          "service": "ecr",
          "last_accessed": "2026-08-27"
        }
      ],
      "analyzer_findings": [
        {
          "finding": "UnusedActions",
          "unused": [
            "iam:CreateAccessKey",
            "iam:DeleteAccessKey"
